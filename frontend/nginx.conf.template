server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker's internal DNS: the backend address is resolved per request,
    # so nginx starts even when the backend is not running (demo mode).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass $backend;
    }

    # Built files have content hashes in their names: cache them for long.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri /index.html;
    }
}
