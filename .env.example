# Copy to .env and fill in the key: cp .env.example .env
# Never commit .env and never put real keys into this file.

APP_NAME=Legal Assistant API
ENVIRONMENT=development
LOG_LEVEL=INFO

API_PREFIX=/api/v1
# Origins allowed to call the API directly (the dockerized interface goes through
# its own nginx proxy and does not need CORS; these are for `npm run dev`).
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION=documents

# OpenAI-compatible API of the hackathon organizers (one key for all three models).
# Base URL and key are issued by the organizers.
LLM_BASE_URL=https://llm-api.example.org/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=baai/bge-m3

RERANKER_ENABLED=true
# Qwen3 Reranker 8B: take the exact model id from the organizers' instructions.
# RERANKER_MODEL=

# Ports on the host machine.
BACKEND_PORT=8000
FRONTEND_PORT=8080
# 1 = the interface shows built-in demo answers and does not call the backend.
FRONTEND_USE_MOCK=0
