# LLM API
OPENAI_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna

# BGE-M3 is loaded locally and never downloaded at runtime.
# EMBEDDING_MODEL_PATH=C:/path/to/bge-m3
# EMBEDDING_CACHE_DIR=C:/path/to/huggingface/hub
# EMBEDDING_DEVICE=cpu
TOP_K=30
RRF_TOP_K=40
RERANKER_CANDIDATES=40
RERANKER_TOP_N=40
FINAL_CONTEXT_TOP_K=20
FAISS_PROTECTED_TOP_K=3
BM25_PROTECTED_TOP_K=3
BM25_CONFIRM_FAISS_TOP_K=15
BM25_CONFIRM_RRF_TOP_K=10
BM25_CONFIRM_RERANKER_SCORE=0.0
MAX_CONTEXT_TOKENS=8000
MIN_CONTEXT_SCORE=0.15
MIN_CONTEXT_RELATIVE_SCORE=0.2
SOURCE_DIVERSITY_PENALTY=0.03
# FAISS_WEIGHT=0.4
# BM25_WEIGHT=0.4
# RRF_WEIGHT=0.1
# RERANKER_WEIGHT=0.1
USE_RERANKER=1
# RRF_SEMANTIC_WEIGHT=1.0
# RRF_BM25_WEIGHT=1.0
# BM25_LEMMATIZE=1

# Optional local Qwen reranker (requires a cached model).
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
# RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=2
RERANKER_MAX_LENGTH=512
MAX_WORKERS=1
# OUTPUT_PATH=submission_reranked.csv
# RERANKER_CACHE_DIR=C:/path/to/model-cache
